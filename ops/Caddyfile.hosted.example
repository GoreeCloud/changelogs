# Illustration only. Replace the hostname after verifying DNS ownership,
# certificate renewal, production ingress parity and an approved private route.
# Do NOT launch this during the VPS migration/cutover without authorization.
changelogs.example.invalid {
    reverse_proxy 127.0.0.1:8876
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}
