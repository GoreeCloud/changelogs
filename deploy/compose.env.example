# Copy to .env at the repository root, then replace both example values.
# Never commit .env, passwords, tokens, or private data to Git.
# Use an existing local, owner-only directory owned by the container UID:GID (10001:10001).
GOREE_CHANGELOGS_DATA_DIR=/srv/goreecloud/changelogs
# Exact approved public HTTPS origin served by a separately configured local reverse proxy.
GOREE_CHANGELOGS_PUBLIC_ORIGIN=https://changelogs.example.com
